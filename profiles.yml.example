trendshelf:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: "{{ env_var('GCP_DATASET', 'bronze') }}"
      keyfile: "{{ env_var('GCP_CREDENTIALS_PATH', 'credentials.json') }}"
      threads: 4
      timeout_seconds: 300
      maximum_bytes_billed: 10737418240
