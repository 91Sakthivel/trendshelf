# BigQuery
GCP_PROJECT_ID=your-project-id
GCP_DATASET=bronze
GCP_CREDENTIALS_PATH=credentials.json

# Kroger API
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret

# SerpAPI
SERPAPI_KEY=your-serpapi-key

# FRED API (free — https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your-fred-api-key

# Collection flags (set False to skip a source on this run)
COLLECT_GOOGLE_TRENDS=False
COLLECT_SERPAPI=True
COLLECT_KROGER=True
COLLECT_FRED=True
COLLECT_BLS=True

# Walmart competitor stores are no longer read from .env -- they're hardcoded in
# config.py's WALMART_STORES list, mirroring KROGER_STORES (not present in this file
# either). See docs/threshold_decisions.md #7.18.
